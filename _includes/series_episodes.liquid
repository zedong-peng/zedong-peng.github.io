{% comment %}
  Ordered list of a series' episodes.
  Params: series_id, lang ('zh' or 'en'), current (episode key to mark).
{% endcomment %}
{% assign series = site.data.series[include.series_id] %}
{% assign lang_key = include.lang %}
<ol class="series-episodes">
  {% for ep in series.episodes %}
    {% assign ep_posts = site.posts | where: 'series', include.series_id | where: 'series_episode', ep.key %}
    {% assign ep_post = nil %}
    {% for candidate in ep_posts %}
      {% assign candidate_language = candidate.lang | default: site.lang %}
      {% if lang_key == 'zh' and candidate_language contains 'zh' %}
        {% assign ep_post = candidate %}
        {% break %}
      {% elsif lang_key == 'en' and candidate_language == 'en' %}
        {% assign ep_post = candidate %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% unless ep_post %}
      {% assign ep_post = ep_posts | first %}
    {% endunless %}
    {% capture ep_title %}{{ ep.from[lang_key] }} → {{ ep.to[lang_key] }}{% endcapture %}
    <li class="{% if ep.key == include.current %}series-episode--current{% elsif ep_post == nil %}series-episode--planned{% endif %}">
      <span class="series-episode-topic">{{ ep.topic[lang_key] }}</span>
      {% if ep.key == include.current %}
        <span class="series-episode-title" aria-current="page">{{ ep_title }}</span>
      {% elsif ep_post %}
        <a class="series-episode-title" href="{{ ep_post.url | relative_url }}">{{ ep_title }}</a>
      {% else %}
        <span class="series-episode-title">{{ ep_title }}</span>
        <span class="series-episode-soon">{% if lang_key == 'zh' %}即将发布{% else %}coming soon{% endif %}</span>
      {% endif %}
    </li>
  {% endfor %}
</ol>
