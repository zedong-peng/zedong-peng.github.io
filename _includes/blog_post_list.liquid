<ul class="list">
  {% for post in include.posts %}
    {% assign post_language = post.lang | default: site.lang %}
    <li>
      {% if post.redirect == blank %}
        <a class="t" href="{{ post.url | relative_url }}">{{ post.title }}</a>
      {% elsif post.redirect contains '://' %}
        <a class="t" href="{{ post.redirect }}">{{ post.title }}</a>
      {% else %}
        <a class="t" href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
      {% endif %}
      <span class="m small">
        {% if post_language contains 'zh' %}{{ post.date | date: '%Y年%-m月%-d日' }}{% else %}{{ post.date | date: '%b %-d, %Y' }}{% endif %}
      </span>
      <p class="d small">
        {{ post.description }}
        {% assign translations = site.posts | where: 'translation_key', post.translation_key %}
        {% if post.translation_key and translations.size > 1 %}
          {% include post_language_control.liquid post=post %}
        {% elsif post_language contains 'zh' %}
          <span class="post-language-control">中文</span>
        {% endif %}
      </p>
    </li>
  {% endfor %}
</ul>
