{% comment %} The site header. Standalone pages under zedongpeng.com copy this markup and link /assets/css/site.css. {% endcomment %}
<header class="zp-top" id="navbar">
  <a class="zp-home" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
  <a href="{{ '/blog/' | relative_url }}" {% if page.url contains '/blog/' %}aria-current="page"{% endif %}>Posts</a>
  <a href="{{ '/cv/' | relative_url }}" {% if page.url == '/cv/' %}aria-current="page"{% endif %}>CV</a>
</header>
