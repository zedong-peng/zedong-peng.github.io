{% comment %} The site header. Standalone pages under zedongpeng.com get this markup from /assets/js/site-header.js. {% endcomment %}
<header class="zp-top" id="navbar">
  <a class="zp-home" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
  <div class="zp-menu">
    <a href="{{ '/blog/' | relative_url }}" aria-haspopup="true" {% if page.url contains '/blog/' %}aria-current="page"{% endif %}>Posts</a>
    <div class="zp-panel">
      <div>
        <a href="{{ '/blog/' | relative_url }}">Overview</a>
        {% for category in site.display_categories %}
        <a href="{{ '/blog/category/' | append: category | append: '/' | relative_url }}">{{ site.category_names[category] | default: category }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
  <a href="{{ '/cv/' | relative_url }}" {% if page.url == '/cv/' %}aria-current="page"{% endif %}>CV</a>
</header>
