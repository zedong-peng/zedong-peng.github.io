{% comment %} kramdown turns $$…$$ into \[…\] or \(…\), so those are what a post with math contains. {% endcomment %}
{% if page.content contains '\[' or page.content contains '\(' %}
  <script src="{{ '/assets/js/mathjax-setup.js' | relative_url | bust_file_cache }}"></script>
  <script
    defer
    src="{{ site.mathjax.url }}"
    integrity="{{ site.mathjax.integrity }}"
    crossorigin="anonymous"
  ></script>
{% endif %}
