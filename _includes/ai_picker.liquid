<div class="ai-picker" id="ai-picker">
  <noscript>
    国产模型：用 OpenCode Go。OpenAI：每月十块左右的梯子，先测纯净度。Claude：认识我就找我开账号，不认识就找每月一百块左右的家宽梯子。订阅：OpenCode
    Go 可以用支付宝或微信；OpenAI 和 Claude 用苹果 App Store 礼品卡、Google Pay 或国外银行卡，港卡不行。
  </noscript>
</div>

<style>
  .ai-picker {
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .ai-picker .ap-trail {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--global-text-color-light);
  }
  .ai-picker .ap-trail:empty {
    display: none;
  }
  .ai-picker .ap-trail span {
    cursor: pointer;
  }
  .ai-picker .ap-trail span:hover {
    color: var(--global-theme-color);
  }
  .ai-picker .ap-q {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .ai-picker .ap-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ai-picker button {
    border: 1px solid var(--global-theme-color);
    border-radius: 6px;
    background: transparent;
    color: var(--global-theme-color);
    padding: 0.35rem 0.9rem;
    cursor: pointer;
  }
  .ai-picker button:hover,
  .ai-picker button.on {
    background: var(--global-theme-color);
    color: var(--global-hover-text-color);
  }
  .ai-picker button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .ai-picker .ap-end {
    margin-bottom: 0.75rem;
  }
  .ai-picker .ap-end ol {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('ai-picker');
    var short = { cn: '国产', openai: 'OpenAI', claude: 'Claude' };

    // A Linux account on my machine, for Claude Code. The reader may install other AIs there too.
    function mine(s) {
      return s.client === 'code';
    }
    // AIs the reader runs in a terminal; Claude Desktop goes over remote desktop instead.
    function agents(s) {
      return (s.ai || []).filter(function (p) {
        return !(p === 'claude' && s.client === 'desktop');
      });
    }

    // AIs that run on the reader's own computer. Managed together with Claude, they all move to my machine.
    function local(s) {
      if (mine(s) && s.unify) return [];
      return agents(s).filter(function (p) {
        return !(p === 'claude' && mine(s));
      });
    }

    var qs = [
      {
        id: 'ai',
        multi: true,
        q: '你想用哪些 AI？可以多选。',
        opts: [
          ['cn', '国产模型'],
          ['openai', 'OpenAI'],
          ['claude', 'Claude（推荐）'],
        ],
      },
      {
        id: 'know',
        when: function (s) {
          return s.ai.indexOf('claude') >= 0;
        },
        q: '你认识我吗？能接受用我海外家里的电脑吗？它的硬盘不大。',
        opts: [
          [true, '认识，也能接受'],
          [false, '不认识，或不想用'],
        ],
      },
      {
        id: 'client',
        when: function (s) {
          return s.know === true;
        },
        q: '你用 Claude Desktop 还是 Claude Code？',
        opts: [
          ['desktop', 'Claude Desktop'],
          ['code', 'Claude Code'],
        ],
      },
      {
        id: 'ssh',
        when: function (s) {
          return agents(s).length > 0;
        },
        q: '你需要 ssh 到自己的工作环境吗？比如实验室的 GPU 服务器，或者自己的电脑。',
        opts: [
          [true, '需要', '要 ssh'],
          [false, '不需要', '不 ssh'],
        ],
      },
      {
        id: 'multi',
        when: function (s) {
          return agents(s).length > 0;
        },
        q: '你需要在手机、电脑、网页上都能看到 AI 的进度吗？',
        opts: [
          [true, '需要', '要多端'],
          [false, '不需要', '不要多端'],
        ],
      },
      {
        id: 'unify',
        when: function (s) {
          return agents(s).length > 1;
        },
        q: '这几家 AI，想放在一个界面里统一管理吗？',
        opts: [
          [true, '想', '统一管理'],
          [false, '不用，各用各的', '各用各的'],
        ],
      },
    ];

    function plan(s) {
      var me = mine(s);
      var own = local(s);
      var steps = [];
      if (s.client === 'desktop') steps.push('Claude：我给你开<a href="https://uuyc.163.com/">网易 UU 远程</a>，直接用那台电脑的桌面。');
      if (me) steps.push('Claude：我把这台电脑的 Tailscale 节点 share 给你，再给你建一个 Linux 用户，你自己 ssh 进去。');
      if (me && s.unify) {
        if (s.ai.indexOf('cn') >= 0) steps.push('国产模型：也在这台电脑上用 <a href="https://opencode.ai/go">OpenCode Go</a>。');
        if (s.ai.indexOf('openai') >= 0) steps.push('OpenAI：Codex 也装在这台电脑上，它在海外，不用梯子。');
      }
      own.forEach(function (p) {
        if (p === 'cn') steps.push('国产模型：用 <a href="https://opencode.ai/go">OpenCode Go</a>。');
        if (p === 'openai')
          steps.push(
            'OpenAI：找个每月十块钱左右的梯子，先在 <a href="https://ip.net.coffee/gpt/">ip.net.coffee/gpt</a> 测一下纯净度。OpenAI 不怎么封号，够用了。'
          );
        if (p === 'claude')
          steps.push(
            'Claude：找个每月一百块左右的家宽梯子，先在 <a href="https://ip.net.coffee/claude/">ip.net.coffee/claude</a> 测一下纯净度，然后自己搞定。'
          );
      });
      if (s.ssh && me) steps.push('在我这台电脑上启动用户级 Tailscale，连回你自己的机器（下文第 3 步）。');
      if (s.ssh && own.length) steps.push('你的电脑和工作环境都装上 Tailscale，配好 SSH 密钥，你电脑上的 AI 就能直接 ssh 过去。');
      var native = {
        cn: '国产模型：电脑上跑 <code>opencode web</code>，手机装 Tailscale 打开网页就能看。',
        openai: 'OpenAI：用 Codex App 自带的远程，手机上的 ChatGPT App 就能接着看。Codex App 要跑在 Mac 或 Windows 上。',
        claude: 'Claude：用 Claude Code 自带的 Remote Control，手机上的 Claude App 也要挂梯子。',
      };
      if (s.unify)
        steps.push(
          (me ? '在我这台电脑上启动 T3 Code（下文第 2 步）' : '在你的电脑上启动 T3 Code') +
            '，几家 AI 放在一个界面里' +
            (s.multi ? '，手机、电脑、网页都能看进度。' : '。')
        );
      else if (s.multi) {
        if (me) steps.push('Claude：在我这台电脑上启动 T3 Code（下文第 2 步）。手机直接开 Claude App 要挂梯子，T3 Code 走 Tailscale 不用。');
        own.forEach(function (p) {
          steps.push(native[p]);
        });
      }
      var pay = [];
      if (s.ai.indexOf('cn') >= 0) pay.push('OpenCode Go 可以用支付宝或微信');
      var intl = s.ai
        .filter(function (p) {
          return p !== 'cn';
        })
        .map(function (p) {
          return short[p];
        });
      if (intl.length) pay.push(intl.join(' 和 ') + ' 用苹果 App Store 礼品卡、Google Pay 或国外银行卡，港卡不行');
      steps.push('订阅：' + pay.join('；') + '。');
      return '你要做这几件事：<ol><li>' + steps.join('</li><li>') + '</li></ol>';
    }

    var ans = {};
    var sel = [];
    var cur = null;

    function crumb(q) {
      if (q.multi)
        return ans[q.id]
          .map(function (p) {
            return short[p];
          })
          .join(' + ');
      var o = q.opts.filter(function (o) {
        return o[0] === ans[q.id];
      })[0];
      return o[2] || o[1];
    }

    function render() {
      var html = '<div class="ap-trail">';
      var n = 0;
      cur = null;
      for (var k = 0; k < qs.length; k++) {
        var q = qs[k];
        if (q.when && !q.when(ans)) continue;
        if (!(q.id in ans)) {
          cur = q;
          break;
        }
        html += (n++ ? ' › ' : '') + '<span data-back="' + k + '">' + crumb(q) + '</span>';
      }
      html += '</div>';
      if (!cur) {
        html += '<div class="ap-end">' + plan(ans) + '</div><button data-reset="1">重新选</button>';
      } else {
        html += '<div class="ap-q">' + cur.q + '</div><div class="ap-opts">';
        cur.opts.forEach(function (o, i) {
          var on = cur.multi && sel.indexOf(o[0]) >= 0;
          html += '<button data-i="' + i + '"' + (on ? ' class="on"' : '') + '>' + o[1] + '</button>';
        });
        if (cur.multi) html += '<button data-next="1"' + (sel.length ? '' : ' disabled') + '>下一步</button>';
        html += '</div>';
      }
      root.innerHTML = html;
    }

    root.addEventListener('click', function (e) {
      var el = e.target.closest('[data-i],[data-next],[data-back],[data-reset]');
      if (!el) return;
      var d = el.dataset;
      if (d.i !== undefined && cur.multi) {
        var v = cur.opts[+d.i][0];
        sel = sel.indexOf(v) >= 0 ? sel.filter((p) => p !== v) : sel.concat(v);
      } else if (d.i !== undefined) {
        ans[cur.id] = cur.opts[+d.i][0];
      } else if (d.next !== undefined) {
        ans.ai = qs[0].opts
          .map(function (o) {
            return o[0];
          })
          .filter(function (p) {
            return sel.indexOf(p) >= 0;
          });
      } else if (d.back !== undefined) {
        qs.slice(+d.back).forEach(function (q) {
          delete ans[q.id];
        });
      } else {
        ans = {};
        sel = [];
      }
      render();
    });

    render();
  })();
</script>
