<div class="ai-picker" id="ai-picker">
  <noscript>
    国产模型：用 OpenCode Go。OpenAI：每月十块左右的梯子，先测纯净度。Claude：认识我就找我开账号，不认识就找每月一百块左右的家宽梯子。
  </noscript>
</div>

<style>
  .ai-picker {
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .ai-picker .ap-trail {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--global-text-color-light);
  }
  .ai-picker .ap-trail:empty {
    display: none;
  }
  .ai-picker .ap-trail span {
    cursor: pointer;
  }
  .ai-picker .ap-trail span:hover {
    color: var(--global-theme-color);
  }
  .ai-picker .ap-q {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .ai-picker .ap-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ai-picker button {
    border: 1px solid var(--global-theme-color);
    border-radius: 6px;
    background: transparent;
    color: var(--global-theme-color);
    padding: 0.35rem 0.9rem;
    cursor: pointer;
  }
  .ai-picker button:hover {
    background: var(--global-theme-color);
    color: var(--global-hover-text-color);
  }
  .ai-picker .ap-end {
    margin-bottom: 0.75rem;
  }
  .ai-picker .ap-end ol {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('ai-picker');
    var nodes = {
      start: {
        q: '你想用哪家的 AI？',
        opts: [
          { t: '国产模型', end: '用 <a href="https://opencode.ai/go">OpenCode Go</a> 就行。' },
          {
            t: 'OpenAI',
            end: '找个每月十块钱左右的梯子，先在 <a href="https://ip.net.coffee/gpt/">ip.net.coffee/gpt</a> 测一下纯净度。OpenAI 不怎么封号，够用了。',
          },
          { t: 'Claude（推荐）', next: 'know' },
        ],
      },
      know: {
        q: '你认识我吗？能接受用我海外家里的电脑吗？它的硬盘不大。',
        opts: [
          {
            t: '不认识，或不想用',
            end: '找个每月一百块左右的家宽梯子，先在 <a href="https://ip.net.coffee/claude/">ip.net.coffee/claude</a> 测一下纯净度，然后自己搞定。',
          },
          { t: '认识，也能接受', next: 'client' },
        ],
      },
      client: {
        q: '你用 Claude Desktop 还是 Claude Code？',
        opts: [
          { t: 'Claude Desktop', end: '我给你开<a href="https://uuyc.163.com/">网易 UU 远程</a>，直接用那台电脑的桌面。' },
          { t: 'Claude Code', next: 'ssh' },
        ],
      },
      ssh: {
        q: '你需要 ssh 到自己的工作环境吗？比如实验室的 GPU 服务器，或者自己的电脑。',
        opts: [
          { t: '需要', b: '要 ssh', key: 'ssh', val: true, next: 'multi' },
          { t: '不需要', b: '不 ssh', key: 'ssh', val: false, next: 'multi' },
        ],
      },
      multi: {
        q: '你需要在手机、电脑、网页上都能看到 AI 的进度吗？',
        opts: [
          { t: '需要', b: '要多端', key: 't3', val: true, end: plan },
          { t: '不需要', b: '不要多端', key: 't3', val: false, end: plan },
        ],
      },
    };

    function plan(s) {
      var steps = ['我把这台电脑的 Tailscale 节点 share 给你。', '我在上面给你建一个 Linux 用户，你自己 ssh 进去。'];
      if (s.ssh) steps.push('启动用户级 Tailscale，连回你自己的机器（下文第 3 步）。');
      if (s.t3) steps.push('启动 T3 Code（下文第 2 步）。');
      return '你要做这几件事：<ol><li>' + steps.join('</li><li>') + '</li></ol>';
    }

    var path = [];

    function render() {
      var state = {};
      var id = 'start';
      var end = null;
      var html = '<div class="ap-trail">';
      path.forEach(function (i, n) {
        var o = nodes[id].opts[i];
        html += (n ? ' › ' : '') + '<span data-n="' + n + '">' + (o.b || o.t) + '</span>';
        if (o.key) state[o.key] = o.val;
        if (o.end) end = typeof o.end === 'function' ? o.end(state) : o.end;
        else id = o.next;
      });
      html += '</div>';
      if (end) {
        html += '<div class="ap-end">' + end + '</div><button data-reset="1">重新选</button>';
      } else {
        html += '<div class="ap-q">' + nodes[id].q + '</div><div class="ap-opts">';
        nodes[id].opts.forEach(function (o, i) {
          html += '<button data-i="' + i + '">' + o.t + '</button>';
        });
        html += '</div>';
      }
      root.innerHTML = html;
    }

    root.addEventListener('click', function (e) {
      var el = e.target.closest('[data-i],[data-n],[data-reset]');
      if (!el) return;
      if (el.dataset.i !== undefined) path.push(+el.dataset.i);
      else if (el.dataset.n !== undefined) path = path.slice(0, +el.dataset.n);
      else path = [];
      render();
    });

    render();
  })();
</script>
