{% assign active_language = include.active_language | default: 'all' %}

<nav class="blog-language-switcher" aria-label="Blog language">
  <div class="btn-group" role="group">
    <a
      class="btn btn-sm {% if active_language == 'all' %}btn-primary{% else %}btn-outline-primary{% endif %}"
      href="{{ '/blog/' | relative_url }}"
      {% if active_language == 'all' %}
        aria-current="page"
      {% endif %}
    >
      All
    </a>
    <a
      class="btn btn-sm {% if active_language == 'zh-CN' %}btn-primary{% else %}btn-outline-primary{% endif %}"
      href="{{ '/blog/zh/' | relative_url }}"
      lang="zh-CN"
      hreflang="zh-CN"
      {% if active_language == 'zh-CN' %}
        aria-current="page"
      {% endif %}
    >
      中文
    </a>
    <a
      class="btn btn-sm {% if active_language == 'en' %}btn-primary{% else %}btn-outline-primary{% endif %}"
      href="{{ '/blog/en/' | relative_url }}"
      lang="en"
      hreflang="en"
      {% if active_language == 'en' %}
        aria-current="page"
      {% endif %}
    >
      English
    </a>
  </div>
</nav>
