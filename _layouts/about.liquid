---
layout: default
---
<article class="wide page-head">
  <div class="home">
    <div class="prose">
      <h1>{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="lead">{{ page.subtitle }}</p>
      {{ content }}
      <ul class="links small">
        {% assign s = site.data.socials %}
        {% if s.email %}<li><a href="mailto:{{ s.email | encode_email }}">Email</a></li>{% endif %}
        {% if s.github_username %}<li><a href="https://github.com/{{ s.github_username }}">GitHub</a></li>{% endif %}
        {% if s.scholar_userid %}<li><a href="https://scholar.google.com/citations?user={{ s.scholar_userid }}">Google Scholar</a></li>{% endif %}
        {% if s.x_username %}<li><a href="https://x.com/{{ s.x_username }}">X</a></li>{% endif %}
        {% if s.linkedin_username %}<li><a href="https://www.linkedin.com/in/{{ s.linkedin_username }}">LinkedIn</a></li>{% endif %}
        {% if s.wechat_qr %}<li><a href="{{ s.wechat_qr | prepend: '/assets/img/' | relative_url }}">WeChat</a></li>{% endif %}
      </ul>
    </div>
    {% if page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid loading="eager" path=profile_image_path sizes="(min-width: 600px) 220px, 180px" alt="Zedong Peng" cache_bust=true %}
    {% endif %}
  </div>
</article>
