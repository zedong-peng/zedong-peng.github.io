---
layout: default
---
{% if page._styles %}
  <style>
    {{ page._styles }}
  </style>
{% endif %}
<article>
  <header class="col page-head">
    <h1>{{ page.title }}</h1>
    {% if page.description %}<p class="lead">{{ page.description }}</p>{% endif %}
  </header>
  <div class="col prose">{{ content }}</div>
</article>
