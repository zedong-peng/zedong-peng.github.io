---
---
{% comment %} One publication on the CV page (_layouts/cv.liquid), rendered by jekyll-scholar. {% endcomment %}
{% comment %} Every resource is a bracketed label after the title, in a fixed order: [paper] [arxiv] [pdf] [code] [data]
  [slides] [poster] [video]. The title itself is not a link. [paper] is the venue page (website); an arXiv-only entry
  gets [arxiv] and no [paper]. Publication URLs are absolute so that they work in the PDF, which the deploy workflow
  prints from this page. {% endcomment %}
{% assign base = site.url %}
<div class="cv-entry">
  <div class="cv-main">
    <h3>
      <b>{{ entry.title }}</b>
      {%- if entry.website %} <a class="cv-link" href="{{ entry.website }}">[paper]</a>{% endif -%}
      {%- if entry.arxiv %} <a class="cv-link" href="{{ entry.arxiv | prepend: 'https://arxiv.org/abs/' }}">[arxiv]</a>{% endif -%}
      {%- if entry.pdf %} <a class="cv-link" href="{{ entry.pdf | prepend: '/assets/pdf/' | prepend: base }}">[pdf]</a>{% endif -%}
      {%- if entry.code %} <a class="cv-link" href="{{ entry.code }}">[code]</a>{% endif -%}
      {%- if entry.data %} <a class="cv-link" href="{{ entry.data }}">[data]</a>{% endif -%}
      {%- if entry.slides %} <a class="cv-link" href="{% if entry.slides contains '://' %}{{ entry.slides }}{% else %}{{ entry.slides | prepend: '/assets/pdf/' | prepend: base }}{% endif %}">[slides]</a>{% endif -%}
      {%- if entry.poster %} <a class="cv-link" href="{% if entry.poster contains '://' %}{{ entry.poster }}{% else %}{{ entry.poster | prepend: '/assets/pdf/' | prepend: base }}{% endif %}">[poster]</a>{% endif -%}
      {%- if entry.video %} <a class="cv-link" href="{{ entry.video }}">[video]</a>{% endif %}
    </h3>
    <p>
      {% for author in entry.author_array -%}
        {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
          <b>
            {{- author.first }}
            {{ author.last -}}
          </b>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor %}
    </p>
    <p>
      <em>{{ entry.booktitle | default: entry.journal }}</em>
    </p>
  </div>
  <div class="cv-side">
    <span>{{ entry.year }}</span>
  </div>
</div>
