---
---
{% comment %} One publication on the CV page (_layouts/cv.liquid), rendered by jekyll-scholar. {% endcomment %}
{% if entry.website %}
  {% assign link = entry.website %}
{% elsif entry.arxiv %}
  {% assign link = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
{% else %}
  {% assign link = null %}
{% endif %}
<div class="cv-entry">
  <div class="cv-main">
    <h3>
      {% if link -%}
        <a href="{{ link }}">{{ entry.title }}</a>
      {%- else -%}
        {{- entry.title -}}
      {%- endif %}
    </h3>
    <p>
      {% for author in entry.author_array -%}
        {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
          <b>
            {{- author.first }}
            {{ author.last -}}
          </b>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor %}
    </p>
    <p>
      <em>{{ entry.booktitle | default: entry.journal }}</em>
    </p>
  </div>
  <div class="cv-side">
    <span>{{ entry.year }}</span>
  </div>
</div>
