---
layout: default
---
{% comment %}
  The photos of _data/gallery.yml on the 12-column grid of anthropic.com/research's gallery view.
  _plugins/gallery-layout.rb gives each photo its columns and its row's alignment, by Anthropic's rule.
  A photo keeps its own aspect ratio.
{% endcomment %}
{% assign photos = site.data.gallery | gallery_layout %}
<article class="gallery page-head">
  <h1>{{ page.title }}</h1>
  <div class="gallery-grid">
    {% for photo in photos %}
      {% assign path = 'assets/img/gallery/' | append: photo.file %}
      {% assign stem = path | split: '.' | first %}
      <figure style="--lg: {{ photo.start }} / span {{ photo.span }}; --md: {{ photo.start_md }} / span {{ photo.span_md }}; --align: {{ photo.align }}; --aspect: {{ photo.width }} / {{ photo.height }}">
        <p class="small"><span>{{ photo.place }}</span><time datetime="{{ photo.date | date: '%Y-%m-%d' }}">{{ photo.date | date: '%b %Y' }}</time></p>
        <a href="{{ path | relative_url }}">
          <picture>
            <source
              type="image/webp"
              srcset="{% for w in site.imagemagick.widths %}{{ stem | relative_url }}-{{ w }}.webp {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
              sizes="(min-width: 1280px) {{ photo.span | times: 100 | divided_by: 12 }}vw, (min-width: 768px) {{ photo.span_md | times: 100 | divided_by: 12 }}vw, 100vw"
            >
            <img src="{{ path | relative_url }}" width="{{ photo.width }}" height="{{ photo.height }}" alt="{{ photo.alt | default: photo.caption | default: photo.place | escape }}" loading="lazy" decoding="async">
          </picture>
        </a>
        {% if photo.caption %}<figcaption class="small">{{ photo.caption }}</figcaption>{% endif %}
      </figure>
    {% endfor %}
  </div>
</article>
