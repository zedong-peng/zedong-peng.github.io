---
layout: default
---
{% assign page_language = page.lang | default: site.lang %}
{% if page._styles %}
  <style>
    {{ page._styles }}
  </style>
{% endif %}
<article>
  <header class="col page-head">
    <p class="eyebrow">
      {% for category in page.categories %}
        <a href="{{ '/blog/' | relative_url }}#{{ category | slugify }}">{{ category | capitalize }}</a> ·
      {% endfor %}
      {% if page_language contains 'zh' %}
        {{ page.date | date: '%Y年%-m月%-d日' }}
      {% else %}
        {{ page.date | date: '%B %-d, %Y' }}
      {% endif %}
      {% assign translations = site.posts | where: 'translation_key', page.translation_key %}
      {% if page.translation_key and translations.size > 1 %}
        · {% include post_language_control.liquid post=page %}
      {% endif %}
    </p>
    <h1>{{ page.title }}</h1>
  </header>
  <div class="col prose">
    {% if page.series %}
      {% include series_box.liquid %}
    {% endif %}
    {% if page.toc and page.toc.beginning %}
      <nav id="table-of-contents">{% toc %}</nav>
    {% endif %}
    {% if page.agent_prompt %}
      {% include agent_prompt.liquid %}
    {% endif %}
    {{ content }}
  </div>
  {% if site.giscus and page.giscus_comments %}
    <div class="col">{% include giscus.liquid %}</div>
  {% endif %}
</article>
