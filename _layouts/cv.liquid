---
layout: default
---
{% comment %}
  The CV, from _data/cv.yml and _bibliography/papers.bib. Everything is plain HTML on the page so that readers and
  agents see all of it; the deploy workflow prints this page to /assets/pdf/Zedong_Peng_CV.pdf. Links are made
  absolute so that they also work in the PDF.
{% endcomment %}
{% assign cv = site.data.cv %}
{% capture absolute %}href="{{ site.url }}/{% endcapture %}
<style>
  .cv {
    max-width: 820px;
    margin: 0 auto 3rem;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.45;
  }
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1.5rem;
  }
  .cv-head h1 {
    font-size: 1.6em;
    font-weight: 700;
    margin: 0 auto 0 0;
  }
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.2rem;
    margin: 0;
  }
  .cv-pdf {
    white-space: nowrap;
  }
  .cv-updated {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }
  .cv h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1em;
    font-weight: 700;
    margin: 1rem 0 0.4rem;
  }
  .cv h2::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--global-text-color);
    opacity: 0.6;
  }
  .cv h2.bibliography {
    display: none;
  }
  .cv ol.bibliography {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cv-entry {
    display: flex;
    gap: 1rem;
    margin: 0 0 0.65rem;
  }
  .cv-main {
    flex: 1;
    min-width: 0;
  }
  .cv-side {
    flex: none;
    text-align: right;
    white-space: nowrap;
  }
  .cv-side span {
    display: block;
  }
  .cv h3 {
    font-size: 1em;
    font-weight: 400;
    line-height: inherit;
    margin: 0;
  }
  .cv-main p {
    margin: 0.1rem 0 0;
  }
  .cv section > p {
    margin: 0 0 0.25rem;
  }
  .cv-main ul {
    margin: 0.15rem 0 0;
    padding-left: 1.3rem;
  }
  .cv-compact .cv-entry {
    margin-bottom: 0.25rem;
  }
  @media (max-width: 576px) {
    .cv-contact {
      order: 1;
      flex-basis: 100%;
    }
    .cv-entry {
      flex-direction: column;
      gap: 0;
    }
    .cv-side {
      order: -1;
      white-space: normal;
      text-align: left;
      font-size: 0.85em;
      color: var(--global-text-color-light);
    }
    .cv-side span {
      display: inline;
    }
    .cv-side span + span::before {
      content: ' · ';
    }
  }
  @media print {
    @page {
      size: A4;
      margin: 1.5cm 1.7cm;
    }
    html,
    html[data-theme='dark'] {
      --global-bg-color: #fff;
      --global-text-color: #000;
      --global-text-color-light: #555;
    }
    body,
    body > .container {
      min-width: 0 !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    body > header,
    body > footer,
    #back-to-top,
    .cv-pdf {
      display: none !important;
    }
    .cv {
      max-width: none;
      margin: 0;
      font-size: 10pt;
    }
    .cv a {
      text-decoration: none !important;
    }
    .cv-head,
    .cv-entry {
      break-inside: avoid;
    }
    .cv h2 {
      break-after: avoid;
    }
  }
</style>

<article class="cv">
  <header class="cv-head">
    <h1>{{ cv.name }}</h1>
    <p class="cv-contact">
      <a href="mailto:{{ cv.email }}">{{ cv.email }}</a>
      <a href="{{ cv.website }}">{{ cv.website | remove: 'https://' }}</a>
    </p>
    <a class="cv-pdf" href="{{ site.url }}/assets/pdf/Zedong_Peng_CV.pdf" download><i class="fa-solid fa-file-pdf"></i> PDF</a>
  </header>

  {% for section in cv.sections %}
    <section class="{% if section.compact %}cv-compact{% endif %}">
      <h2>{{ section.title }}</h2>
      {% if section.bibliography %}
        {% bibliography -T cv_publication %}
      {% elsif section.pairs %}
        {% for pair in section.pairs %}
          <p>
            <b>{{ pair.label }}:</b> {{ pair.value }}
          </p>
        {% endfor %}
      {% else %}
        {% for entry in section.entries %}
          <div class="cv-entry">
            <div class="cv-main">
              {% assign title = entry.title | markdownify | remove: '<p>' | remove: '</p>' | strip | replace: 'href="/', absolute %}
              <h3>
                {% if section.compact -%}
                  {{- title -}}
                {%- else -%}
                  <b>{{ title }}</b>
                {%- endif %}
                {%- if entry.org -%}
                  , <em>{{ entry.org }}</em>
                {%- endif %}
              </h3>
              {% if entry.summary %}
                {{ entry.summary | markdownify | replace: 'href="/', absolute }}
              {% endif %}
              {% if entry.highlights %}
                <ul>
                  {% for h in entry.highlights %}
                    <li>{{ h | markdownify | remove: '<p>' | remove: '</p>' | strip | replace: 'href="/', absolute }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
            <div class="cv-side">
              {% if entry.place -%}
                <span>{{ entry.place }}</span>
              {%- endif %}
              <span>{{ entry.dates }}</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </section>
  {% endfor %}
  <p class="cv-updated">Updated {{ cv.updated | date: '%B %Y' }}</p>
</article>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ cv.name | jsonify }},
    "alternateName": {{ cv.alternate_name | jsonify }},
    "url": {{ cv.website | jsonify }},
    "email": {{ cv.email | jsonify }},
    "affiliation": { "@type": "CollegeOrUniversity", "name": {{ cv.affiliation | jsonify }} },
    "alumniOf": { "@type": "CollegeOrUniversity", "name": {{ cv.affiliation | jsonify }} },
    "sameAs": {{ cv.links | map: 'url' | jsonify }}
  }
</script>
