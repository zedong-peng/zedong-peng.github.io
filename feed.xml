---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{% comment %} The Atom feed. A post that lives on its own site links there. {% endcomment %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.first_name }} {{ site.last_name }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.first_name }} {{ site.last_name }}</name></author>
  {% for post in site.posts limit: 20 %}
  {% if post.redirect == blank %}{% assign post_link = post.url | absolute_url %}{% elsif post.redirect contains '://' %}{% assign post_link = post.redirect %}{% else %}{% assign post_link = post.redirect | absolute_url %}{% endif %}
  <entry xml:lang="{{ post.lang | default: site.lang }}">
    <title type="html">{{ post.title | strip | xml_escape }}</title>
    <link href="{{ post_link }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {% for category in post.categories %}<category term="{{ category | xml_escape }}"/>{% endfor %}
    <summary type="html">{{ post.description | strip | xml_escape }}</summary>
    {% if post.redirect == blank %}<content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | strip | xml_escape }}</content>{% endif %}
  </entry>
  {% endfor %}
</feed>
